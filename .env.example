# =====================================================================
# UNIFLOW ∞ — Environment Variable Template
# Copy to .env.local for local development. Never commit .env.local.
# =====================================================================

# Supabase Source of Truth (Phase 2)
# Found in Supabase Dashboard -> Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only service role key (NEVER expose to browser / NEXT_PUBLIC)
SUPABASE_SERVICE_ROLE_KEY=

# LLM Advisory Proposal Engine (Phase 3)
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_TIMEOUT_MS=15000
GROQ_MAX_INPUT_TOKENS=8000

# Azure Blob Storage (Phase 4 - Private Specs & Reports Container)
AZURE_STORAGE_ACCOUNT=
AZURE_STORAGE_CONTAINER=uniflow-specs-private
AZURE_STORAGE_SAS_TOKEN=

# Azure SQL Evidence Store (Phase 5 - Append-Only Run Ledger)
AZURE_SQL_SERVER=
AZURE_SQL_DATABASE=uniflow-evidence
AZURE_SQL_USERNAME=
AZURE_SQL_PASSWORD=
